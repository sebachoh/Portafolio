{
  "name": "portafolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio personnel de Sebastian Ruiz — sebastianruiz.me",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i assets/css/tailwind-input.css -o assets/css/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i assets/css/tailwind-input.css -o assets/css/tailwind.css --watch",
    "serve": "python3 -m http.server 8000",
    "build:fonts": "python3 -m fontTools.subset assets/fonts/ahsing-regular.otf --unicodes=U+0020-007E,U+00A0-00FF,U+0152-0153,U+2018-201D,U+2026,U+20AC --flavor=woff2 --output-file=assets/fonts/ahsing-regular.woff2 --layout-features=* --no-hinting",
    "build": "npm run build:css"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}